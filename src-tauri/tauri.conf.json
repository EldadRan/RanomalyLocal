{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ranomaly Local",
  "version": "0.1.0",
  "identifier": "com.ranomaly.ext",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ranomaly Local",
        "width": 460,
        "height": 240,
        "minWidth": 420,
        "minHeight": 160,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ranomalylocal"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "category": "Utility",
    "shortDescription": "Local helper for AAB",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
